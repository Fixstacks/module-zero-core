<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Compat modules: templates of Vendor_Module come from its registered
        compat module on Zero themes (see Model\Compat\Registry). Global, not
        frontend-only: emails sent from the admin render a store's theme too.
    -->
    <type name="Magento\Framework\View\Element\Template\File\Resolver">
        <plugin name="zero_core_use_compat_templates" type="Zero\Core\Plugin\View\Element\Template\File\UseCompatTemplates"/>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="zero_compat_report" xsi:type="object">Zero\Core\Console\Command\CompatReportCommand</item>
                <item name="zero_compat_create" xsi:type="object">Zero\Core\Console\Command\CompatCreateCommand</item>
                <item name="zero_images_warm" xsi:type="object">Zero\Core\Console\Command\ImagesWarmCommand</item>
            </argument>
        </arguments>
    </type>
    <!--
        Store views at a path of the main domain (Plugin\Store\StorePathPrefix):
        modules list theirs as its `paths` argument. Global: the admin builds their
        links too (order emails, "View" in a store's product grid).
    -->
    <type name="Magento\Store\Model\Store">
        <plugin name="zero_store_path_prefix" type="Zero\Core\Plugin\Store\StorePathPrefix"/>
    </type>
    <type name="Magento\Store\App\Request\PathInfoProcessor">
        <plugin name="zero_store_path_prefix" type="Zero\Core\Plugin\Store\StorePathPrefix"/>
    </type>
    <type name="Magento\Store\App\Request\StorePathInfoValidator">
        <plugin name="zero_store_path_prefix" type="Zero\Core\Plugin\Store\StorePathPrefix"/>
    </type>
    <type name="Magento\Store\Model\StoreResolver">
        <plugin name="zero_store_path_prefix" type="Zero\Core\Plugin\Store\StorePathPrefix"/>
    </type>
</config>
