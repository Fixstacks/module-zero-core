<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-src">
            <values>
                <value id="zero-youtube-nocookie" type="host">https://www.youtube-nocookie.com</value>
                <value id="zero-vimeo-player" type="host">https://player.vimeo.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
