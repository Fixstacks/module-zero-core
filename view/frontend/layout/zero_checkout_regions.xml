    Region fragment (Controller\Checkout\Regions), shared by checkout and the
    customer address/registration forms, so it lives in Zero_Core and uses the
    quote-independent CountryRegionProvider.
-->
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <body>
        <block class="Magento\Framework\View\Element\Template" name="zero.checkout.regions" cacheable="false"
               template="Zero_Core::checkout/region-select.phtml">
            <arguments>
                <argument name="viewModel" xsi:type="object">Zero\Core\ViewModel\Directory\CountryRegionProvider</argument>
            </arguments>
        </block>
    </body>
</layout>
