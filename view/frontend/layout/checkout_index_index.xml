<?xml version="1.0"?>
<!--
    Copyright © 2026 Roman Pasichnyk
    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Makes the stock checkout (checkout/index/index, the fallback when Zero
    Checkout is disabled) work. It's Knockout-only, so RequireJS/Knockout and
    Blank's CSS are restored on this handle only (as Hyvä does). When Zero
    Checkout is enabled this page redirects before rendering.

    - Assets removed sitewide by name can't be re-added under the same name,
      so they come back under new names: Zero_Core::js/vendor/require.js
      (copy of lib/web/requirejs/require.js) with Block\Requirejs\Config
      generating requirejs-config/mixins against it, and the theme's
      css/vendor/styles-{m,l}.css (Blank's compiled CSS, rems rescaled).
    - sri.js is removed here and added by Block\Requirejs\Config so it lands
      in the right asset group (see that class).
    - cookie_config (removed sitewide) comes back as
      zero.checkout.cookie_config; the RequireJS base URL (require.js block)
      prints only here (the theme's page/js/require_js.phtml).
    - The three customer.* blocks (removed sitewide) are restored:
      customer-data's initStorage() is needed by shipping-rate selection.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="Zero_Core::js/vendor/require.js"/>
        <css src="css/vendor/styles-m.css"/>
        <css src="css/vendor/styles-l.css" media="screen and (min-width: 768px)"/>
        <remove src="Magento_Csp::js/sri.js"/>
    </head>
    <body>
        <referenceContainer name="after.body.start">
            <block class="Zero\Core\Block\Requirejs\Config" name="zero.checkout.requirejs-config"/>
            <block class="Magento\Framework\View\Element\Js\Cookie" name="zero.checkout.cookie_config"
                   template="Magento_Cookie::html/cookie.phtml">
                <arguments>
                    <argument name="session_config" xsi:type="object">Magento\Cookie\Block\DataProviders\SessionConfig</argument>
                </arguments>
            </block>
            <block name="zero.checkout.customer.section.config" class="Magento\Customer\Block\SectionConfig"
                   template="Magento_Customer::js/section-config.phtml">
                <arguments>
                    <argument name="sectionNamesProvider" xsi:type="object">Magento\Customer\Block\SectionNamesProvider</argument>
                </arguments>
            </block>
            <block name="zero.checkout.customer.data" class="Magento\Customer\Block\CustomerData"
                   template="Magento_Customer::js/customer-data.phtml">
                <arguments>
                    <argument name="auth" xsi:type="object">Magento\Customer\ViewModel\Customer\Auth</argument>
                    <argument name="json_serializer" xsi:type="object">Magento\Customer\ViewModel\Customer\JsonSerializer</argument>
                    <argument name="cookie_settings" xsi:type="object">Magento\Customer\ViewModel\CookieSettings</argument>
                </arguments>
            </block>
            <block name="zero.checkout.customer.data.invalidation.rules" class="Magento\Customer\Block\CustomerScopeData"
                   template="Magento_Customer::js/customer-data/invalidation-rules.phtml"/>
        </referenceContainer>
    </body>
</page>
