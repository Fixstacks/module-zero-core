<?xml version="1.0"?>
<!--
    No <update handle="default"/>: this handle renders a single fragment
    block, not a page (see Controller\Customer\Wishlistcounter).
-->
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <body>
        <block class="Magento\Framework\View\Element\Template" name="zero.customer.wishlistcounter" cacheable="false"
               template="Zero_Core::customer/wishlist-counter.phtml">
            <arguments>
                <argument name="viewModel" xsi:type="object">Zero\Core\ViewModel\WishlistCounter</argument>
            </arguments>
        </block>
    </body>
</layout>
