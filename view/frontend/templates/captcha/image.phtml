 *
 * Captcha image + reload button, for the first render and the refresh
 * endpoint (same markup). The container keeps stock's id/class: it's the
 * hx-target. `img_height` goes in the reload URL; the fragment has no
 * wrapping Captcha block to set it (else height="0").
 */

/** @var \Magento\Captcha\Block\Captcha\DefaultCaptcha $block */

$formId = $block->escapeHtmlAttr($block->getFormId());
$captcha = $block->getCaptchaModel();
$imgHeight = (float) $block->getImgHeight();
?>
<div class="field captcha no-label"
     data-captcha="<?= $formId ?>"
     id="captcha-container-<?= $formId ?>">
    <div class="control captcha-image">
        <img alt="<?= $block->escapeHtmlAttr(__('Please type the letters and numbers below')) ?>"
             class="captcha-img"
             height="<?= /* @noEscape */ $imgHeight ?>"
             src="<?= $block->escapeUrl($captcha->getImgSrc()) ?>"/>
        <button type="button"
                class="action reload captcha-reload"
                title="<?= $block->escapeHtmlAttr(__('Reload captcha')) ?>"
                hx-get="<?= $block->escapeUrl(
                    $block->getUrl(
                        'zero/captcha/refresh',
                        ['_query' => ['form_id' => $block->getFormId(), 'img_height' => $imgHeight]]
                    )
                ) ?>"
                hx-target="#captcha-container-<?= $formId ?>"
                hx-swap="outerHTML">
            <span><?= $block->escapeHtml(__('Reload captcha')) ?></span>
        </button>
    </div>
</div>
