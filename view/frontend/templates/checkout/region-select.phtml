 *
 * zero/checkout/regions: a region <select> for country_id, or a text input
 * when it has no list; for checkout and the customer forms. `prefix` (billing)
 * gives the second pair its own id/name, so there are never two region_id.
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Core\ViewModel\Directory\CountryRegionProvider $viewModel
 */
$viewModel = $block->getData('viewModel');
$countryId = (string) $block->getRequest()->getParam('country_id', 'US');
$regions = $viewModel->getRegionsForCountry($countryId);
$prefix = (string) $block->getRequest()->getParam('prefix', '');
$fieldName = $prefix !== '' ? $prefix . '_region_id' : 'region_id';
$freeTextFieldName = $prefix !== '' ? $prefix . '_region' : 'region';
$fieldId = $prefix !== '' ? $prefix . '_region_id' : 'region_id';
$containerId = $prefix !== '' ? $prefix . '-region-field' : 'region-field';
// Browser autofill section, matching the address fields around it.
$autocomplete = ($prefix === 'billing' ? 'billing' : 'shipping') . ' address-level1';
?>
<div id="<?= $escaper->escapeHtmlAttr($containerId) ?>" class="field">
    <label class="label" for="<?= $escaper->escapeHtmlAttr($fieldId) ?>"><?= $escaper->escapeHtml(__('State/Province')) ?></label>
    <?php if (!empty($regions)) : ?>
        <select name="<?= $escaper->escapeHtmlAttr($fieldName) ?>" id="<?= $escaper->escapeHtmlAttr($fieldId) ?>" autocomplete="<?= $escaper->escapeHtmlAttr($autocomplete) ?>" class="select select-bordered w-full">
            <option value=""><?= $escaper->escapeHtml(__('Please select a region')) ?></option>
            <?php foreach ($regions as $regionId => $name) : ?>
                <option value="<?= $escaper->escapeHtmlAttr((string) $regionId) ?>">
                    <?= $escaper->escapeHtml($name) ?>
                </option>
            <?php endforeach; ?>
        </select>
    <?php else : ?>
        <input type="text" name="<?= $escaper->escapeHtmlAttr($freeTextFieldName) ?>" id="<?= $escaper->escapeHtmlAttr($fieldId) ?>" autocomplete="<?= $escaper->escapeHtmlAttr($autocomplete) ?>" class="input input-bordered w-full"
               placeholder="<?= $escaper->escapeHtmlAttr(__('State/Province')) ?>" />
    <?php endif; ?>
</div>
