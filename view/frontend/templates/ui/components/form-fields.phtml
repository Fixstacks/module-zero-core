<form class="grid sm:grid-cols-2 gap-4 max-w-2xl" novalidate>
    <div class="field required">
        <label class="label" for="ui-email"><?= $escaper->escapeHtml(__('Email')) ?></label>
        <input type="email" id="ui-email" name="email" required autocomplete="email"
