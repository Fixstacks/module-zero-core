            <option><?= $escaper->escapeHtml(__('Canada')) ?></option>
        </select>
    </div>
    <div class="field required sm:col-span-2">
        <label class="label" for="ui-postcode"><?= $escaper->escapeHtml(__('ZIP Code')) ?></label>
        <input type="text" id="ui-postcode" name="postcode" required value="ABC"
