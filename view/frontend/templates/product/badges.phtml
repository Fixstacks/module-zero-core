 *
 * "New" / "Sale -N%" badges. One block (zero.product.badges) serves every
 * card: list templates set `product` and render it; without one it prints
 * nothing. The product page has its own instance.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Core\ViewModel\ProductBadges $badgesViewModel
 */
$product = $block->getProduct();
$badgesViewModel = $block->getData('badgesViewModel');
$badges = $product && $badgesViewModel ? $badgesViewModel->getBadges($product) : [];
?>
<?php if ($badges): ?>
    <span class="product-badges">
        <?php foreach ($badges as $badge): ?>
            <span class="product-badge product-badge-<?= $escaper->escapeHtmlAttr($badge['code']) ?>">
                <?= $escaper->escapeHtml($badge['label']) ?>
            </span>
        <?php endforeach; ?>
    </span>
<?php endif; ?>
