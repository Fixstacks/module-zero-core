 *
 * zero/customer/accountlinks: the "top.links" block with stock's link logic.
 * No `load` trigger on the root (an outerHTML swap would refetch forever).
 * It REPLACES the shell's <ul> in Magento_Customer::account/toplinks.phtml:
 * keep the dropdown's positioning classes in sync in both.
 *
 * @var \Magento\Customer\Block\Account\Navigation $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Core\ViewModel\CustomerLoginState $customerLoginStateViewModel
 */
$customerLoginStateViewModel = $block->getData('customerLoginStateViewModel');
$isLoggedIn = $customerLoginStateViewModel && $customerLoginStateViewModel->isLoggedIn();

$links = array_filter($block->getLinks(), static function ($link) use ($isLoggedIn): bool {
    $name = $link->getNameInLayout();
    if ($name === 'header') {
        return false;
    }
    if ($name === 'my-account-link' && !$isLoggedIn) {
        return false;
    }
    return true;
});

$linkOrder = [
    'my-account-link' => 0,
    'authorization-link' => 0,
    'register-link' => 1,
    'wish-list-link' => 2,
    'catalog.compare.link' => 3,
];
usort($links, static function ($linkA, $linkB) use ($linkOrder): int {
    $rankA = $linkOrder[$linkA->getNameInLayout()] ?? count($linkOrder);
    $rankB = $linkOrder[$linkB->getNameInLayout()] ?? count($linkOrder);
    return $rankA <=> $rankB;
});
?>
<ul class="header links menu absolute end-0 top-full z-30 mt-1 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
    <?php foreach ($links as $link): ?>
        <?= /* @noEscape */ $block->renderLink($link) ?>
    <?php endforeach; ?>
</ul>
